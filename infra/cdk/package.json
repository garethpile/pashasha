{
  "name": "pashashapay-infra",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "pashashapay-infra": "bin/pashashapay.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "synth": "AWS_PROFILE=aws-af-south-1-dev cdk synth",
    "deploy:cicd": "AWS_PROFILE=aws-af-south-1-dev cdk deploy PashashaPayCicdStack",
    "deploy:core": "AWS_PROFILE=aws-af-south-1-dev cdk deploy PashashaPayCoreBackendStack",
    "deploy:payment": "AWS_PROFILE=aws-af-south-1-dev cdk deploy PashashaPayPaymentStack",
    "deploy:notifications": "AWS_PROFILE=aws-af-south-1-dev cdk deploy PashashaPayNotificationsStack",
    "deploy:voucher": "AWS_PROFILE=aws-af-south-1-dev cdk deploy PashashaPayVoucherStack",
    "deploy:frontend": "AWS_PROFILE=aws-af-south-1-dev cdk deploy PashashaPayFrontendStack",
    "destroy:cicd": "AWS_PROFILE=aws-af-south-1-dev cdk destroy PashashaPayCicdStack",
    "destroy:core": "AWS_PROFILE=aws-af-south-1-dev cdk destroy PashashaPayCoreBackendStack",
    "destroy:payment": "AWS_PROFILE=aws-af-south-1-dev cdk destroy PashashaPayPaymentStack",
    "destroy:notifications": "AWS_PROFILE=aws-af-south-1-dev cdk destroy PashashaPayNotificationsStack",
    "destroy:voucher": "AWS_PROFILE=aws-af-south-1-dev cdk destroy PashashaPayVoucherStack",
    "destroy:frontend": "AWS_PROFILE=aws-af-south-1-dev cdk destroy PashashaPayFrontendStack"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "aws-cdk": "2.158.0",
    "esbuild": "^0.25.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@aws-cdk/aws-amplify-alpha": "2.158.0-alpha.0",
    "aws-cdk-lib": "2.240.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  }
}
